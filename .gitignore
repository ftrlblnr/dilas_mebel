# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# CRM sqlite database (runtime data — never delete on deploy)
/dilas.db
/dilas.db-journal
/dilas.db-wal
/dilas.db-shm
/dilas.db.bak-*

# runtime content managed via the admin panel/site — not source code
/data/*.json
/public/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
